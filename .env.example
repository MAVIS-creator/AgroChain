# Copy to .env.local and use a funded account from your local Ganache workspace.
# This is a secret private key. Never commit the real .env.local file.
GANACHE_PRIVATE_KEY=0xREPLACE_WITH_LOCAL_GANACHE_ACCOUNT_PRIVATE_KEY

# Optional comma-separated wallet addresses allowed to administer local API incidents.
# If omitted, the API derives the deployer address from GANACHE_PRIVATE_KEY.
SECURITY_ADMIN_ADDRESSES=
